# Required. Neon connection string (use the pooled endpoint).
DATABASE_URL=""

# Required. Signs admin access tokens. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""

# Only for `npm run seed:admin` / `npm run seed:demo` / `npm run demo:setup`.
# seed:admin creates this ADMIN if it does not exist and never changes an existing account (safe to re-run).
# For a local demo put your own values here, in your untracked .env. Never commit real values.
# Password: at least 12 characters. Placeholders below are NOT credentials.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Only for `npm run seed:demo` (uses the same SEED_ADMIN_* account against a running server).
# DEMO_API_URL=http://localhost:3001/api/v1
# The demo command refuses production-mode environments and servers that are not on this machine unless you set, on purpose:
# DEMO_ALLOW_REMOTE=true
# DEMO_ALLOW_PRODUCTION=true

# Optional
# NODE_ENV=development                 # development | test | production
# PORT=3001
# CORS_ORIGINS=http://localhost:3000   # comma-separated allowed browser origins (admin website)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=14
# AUTH_RATE_LIMIT=5                    # login/refresh attempts per IP ...
# AUTH_RATE_WINDOW_SECONDS=60          # ... per window
# PUBLIC_RATE_LIMIT=120                # public learner API (Delivery) requests per IP ...
# PUBLIC_RATE_WINDOW_SECONDS=60        # ... per window

# Media (local filesystem storage for development; the storage adapter is replaceable)
# MEDIA_STORAGE_ROOT=./storage/media
# MEDIA_MAX_BYTES=5242880
# MEDIA_ALLOWED_TYPES=image/png,image/jpeg,image/webp
