# Required. Neon connection string (use the pooled endpoint).
DATABASE_URL=""

# Required. Signs admin access tokens. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""

# Only for `npm run seed:admin` (creates the first ADMIN; safe to re-run).
# Never commit real values. Password: at least 12 characters.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Only for `npm run seed:demo` (uses the same SEED_ADMIN_* account against a running server).
# DEMO_API_URL=http://localhost:3001/api/v1

# Optional
# NODE_ENV=development                 # development | test | production
# PORT=3001
# CORS_ORIGINS=http://localhost:3000   # comma-separated allowed browser origins (admin website)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=14
# AUTH_RATE_LIMIT=5                    # login/refresh attempts per IP ...
# AUTH_RATE_WINDOW_SECONDS=60          # ... per window
# PUBLIC_RATE_LIMIT=120                # public learner API (Delivery) requests per IP ...
# PUBLIC_RATE_WINDOW_SECONDS=60        # ... per window
