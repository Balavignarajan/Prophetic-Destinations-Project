# Required. Neon connection string (use the pooled endpoint).
DATABASE_URL=""

# Required. Signs admin access tokens. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""

# Only for `npm run seed:admin` / `npm run seed:demo` / `npm run demo:setup`.
# seed:admin creates this ADMIN if it does not exist and never changes an existing account (safe to re-run).
# For a local demo put your own values here, in your untracked .env. Never commit real values.
# Password: at least 12 characters. Placeholders below are NOT credentials.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Only for `npm run seed:demo` (uses the same SEED_ADMIN_* account against a running server).
# DEMO_API_URL=http://localhost:3001/api/v1
# The demo command refuses production-mode environments and servers that are not on this machine unless you set, on purpose:
# DEMO_ALLOW_REMOTE=true
# DEMO_ALLOW_PRODUCTION=true

# Optional
# NODE_ENV=development                 # development | test | production
# PORT=3001
# CORS_ORIGINS=http://localhost:3000   # comma-separated allowed browser origins (admin website)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=14
# AUTH_RATE_LIMIT=5                    # login/refresh attempts per IP ...
# AUTH_RATE_WINDOW_SECONDS=60          # ... per window
# PUBLIC_RATE_LIMIT=120                # public learner API (Delivery) requests per IP ...
# PUBLIC_RATE_WINDOW_SECONDS=60        # ... per window

# Media (local filesystem storage for development; the storage adapter is replaceable)
# MEDIA_STORAGE_ROOT=./storage/media
# MEDIA_MAX_BYTES=5242880
# MEDIA_ALLOWED_TYPES=image/png,image/jpeg,image/webp
# MP4 video (video/mp4) and Lottie animations (application/json) are verified by the media module but OFF by default: add them to MEDIA_ALLOWED_TYPES to allow
# uploads, and raise MEDIA_MAX_BYTES (at most 104857600) to the largest video you accept. A Lottie file is always limited to 2 MB. Videos are streamed, not saved offline.
# MEDIA_ALLOWED_TYPES=image/png,image/jpeg,image/webp,video/mp4,application/json

# Path of the Scripture data file (JSON in the format described in src/modules/scripture/domain/dataset.ts). The file in data/ is generated from the Bible-kjv-master
# source by `npm run scripture:convert`; it is a community-maintained transcription that is NOT approved for release (see docs/scripture-source-research.md).
# A relative path is resolved against this backend folder (the one holding package.json), not the directory the server is started from, so this value works for
# `npm run start:dev` and for a host that ships the backend folder. A host that ships only `dist/` must also ship data/kjv.json, or set an absolute path here.
# Unset, missing or invalid: Scripture is reported as unavailable (nothing can be verified or published with Scripture) and the status says why.
SCRIPTURE_DATA_PATH=./data/kjv.json
