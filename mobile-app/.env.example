# EXPO_PUBLIC_API_URL is the ONLY place the backend address is configured. Expo inlines it at build time.
#
#   Development, nothing set  -> http://localhost:3001/api/v1   (iOS simulator, web)
#                                http://10.0.2.2:3001/api/v1    (Android emulator: 10.0.2.2 is the host machine)
#   Physical device           -> your computer's LAN address, e.g. http://192.168.1.20:3001/api/v1
#                                (same Wi-Fi; the backend must listen on 0.0.0.0; allow it through the firewall)
#   Release / production      -> NO default. Set it to the deployed API (https://...) when building. If it is missing or
#                                malformed in a release build, the app shows "App not configured" instead of calling localhost.
#
# The web build additionally needs the web origin in the backend's CORS_ORIGINS.
# No production URL is stored in this repository: it has not been provided.
# EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Store identifiers (NOT decided yet; read by app.config.js at build time, never hard-coded):
# PD_ANDROID_PACKAGE=
# PD_IOS_BUNDLE_ID=

# Optional content settings (none has a decided value yet; nothing is hard-coded, and the app says so on screen when they are missing):
# EXPO_PUBLIC_SHARE_URL=        the link "Invite a Friend" shares (the store page, once it exists). Unset: only the message is shared.
# EXPO_PUBLIC_SHARE_MESSAGE=    the invitation text. Unset: a neutral placeholder message (pending approval).
# EXPO_PUBLIC_ABOUT_URL=        an online copy of About / Privacy Policy / Terms ("Read online"). http(s) only.
# EXPO_PUBLIC_PRIVACY_URL=      Approved bundled text can instead be added in src/content/documents.ts.
# EXPO_PUBLIC_TERMS_URL=
